# Copy to server/.env and adjust. server/.env is gitignored.

# Postgres connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://moolah:your_password@localhost:5432/moolah

# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# Allowed browser origin. Leave unset in dev (the Vite proxy makes requests
# same-origin); set it to your deployed client URL in production.
# CORS_ORIGIN=https://moolah.example.com
